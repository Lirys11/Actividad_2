body {
  font-family: Arial, sans-serif;
  font-size: 14px;
  max-width: 700px;
  margin: 0 auto;
}

header h1 {
  background: #ff6a00;
  color: #fff;
  text-align: center;
  padding: 10px;
  margin: 10px 0;
  font-size: 1.2rem;
}

nav {
  background: lightgreen;
  border: 2px solid #2ecc40;
  padding: 5px;
}

nav ul {
  margin: 0;
  padding-left: 20px;
}

section {
  margin-top: 20px;
  background: #7fffd4;
  padding: 0;
}

section h2 {
  background: #ddd;
  border: 2px solid #ff9f1c;
  text-align: center;
  padding: 6px;
  font-size: 1rem;
}

section > p:first-of-type {
  border: 2px solid red;
  background: #7fffd4;
  padding: 5px;
  margin-bottom: 15px;
}

section img {
  display: block;
  border: 2px solid purple;
  background: #7fffd4;
  padding: 5 px;
  margin-bottom: 15px;
}

section h3 {
  border: 2px solid #0074d9;
  background: #7fffd4;
  margin: 0;
  padding: 3px;
  font-size: 0.8rem;
}

section ul {
  background: yellow;
  border: 2px solid #ffa500;
  margin: 0 0 15px 0;
  padding: 8px 8px 8px 28px;
}

footer {
  margin: 30px 0;
  text-align: center;
  border-top: 2px solid #ff6a00;
  padding-top: 10px;
}